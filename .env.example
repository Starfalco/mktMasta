# =============================================================================
# MKTmasta Environment Configuration
# Copy this file to .env and adjust values for your environment
#   cp .env.example .env
# =============================================================================

# =============================================================================
# LOCAL DEVELOPMENT (docker-compose up on your machine)
# =============================================================================

# Backend (FastAPI)
FASTAPI_ORIGINS=http://localhost,http://localhost:8080,http://localhost:4200,http://localhost:8000
ALLOW_METHODS=GET,POST,PUT,DELETE
PATH_UTILS=/code/utils/
PATH_SCREENER_CACHE=/code/backend/src/cache/screener_cache.parquet
FRONTEND_BASE_URL=

# Local PostgreSQL (runs in Docker, not RDS)
DB_USER=airflow
DB_PASSWORD=airflow
DB_NAME=airflow
RDS_ENDPOINT=localhost
DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${RDS_ENDPOINT}:5432/${DB_NAME}

# Airflow (local)
AIRFLOW_UID=50000
AIRFLOW_GID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=10
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=airflow

# ---------------------------------------------------------------------------
# PRODUCTION (AWS EC2 — set these in .env on the server)
# ---------------------------------------------------------------------------
# DB_USER=mktmasta
# DB_PASSWORD=YourStrongDBPassword
# DB_NAME=mktmasta
# RDS_ENDPOINT=<your-rds-endpoint>.us-east-1.rds.amazonaws.com
# DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${RDS_ENDPOINT}:5432/${DB_NAME}
# FASTAPI_ORIGINS=http://your-domain.com,http://your-server-ip:8000
# FRONTEND_BASE_URL=http://your-domain.com
# AIRFLOW_ADMIN_PASSWORD=YourStrongAirflowPassword
