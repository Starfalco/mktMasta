# =============================================================================
# MKTmasta Environment Configuration
# Copy this file to .env and adjust values for your environment
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------

# CORS origins — comma-separated list of allowed front-end origins
# Local dev: http://localhost:4200,http://localhost:8000
# Prod:      http://your-domain.com
FASTAPI_ORIGINS=http://localhost.***REMOVED***,https://localhost.***REMOVED***,http://localhost,http://localhost:8080,http://localhost:4200,http://localhost:8000,http://***REMOVED***:8080,http://***REMOVED***:4200,http://***REMOVED***:8000,http://***REMOVED***:8080,http://***REMOVED***:4200,http://***REMOVED***:8000

# Allowed HTTP methods — comma-separated
ALLOW_METHODS=GET,POST,PUT,DELETE

# File system paths (adjust for your deployment)
PATH_UTILS=/code/utils/
PATH_SCREENER_CACHE=/code/backend/src/cache/screener_cache.parquet

# Frontend base URL (used by /config.json endpoint)
# Leave empty for relative paths (recommended for reverse-proxy deployments)
# Set to http://your-domain.com for direct deployments
FRONTEND_BASE_URL=

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_GID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=10

# ---------------------------------------------------------------------------
# PostgreSQL / PgAdmin
# ---------------------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
