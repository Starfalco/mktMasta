# Ansible inventory — update IPs after terraform apply
# Or use dynamic inventory from Proxmox

[app_server]
app-server ansible_host=192.168.1.10

[gitlab_server]
gitlab-server ansible_host=192.168.1.11

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_python_interpreter=/usr/bin/python3